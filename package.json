{
  "name": "recherche-careeros",
  "productName": "Recherche CareerOS",
  "version": "1.0.0",
  "description": "A local-first macOS career operations workspace.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:demo": "RECHERCHE_CAREER_OPS_SOURCE=fixtures/demo-career-ops npm start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "sbom": "npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type application > sbom.cdx.json",
    "verify:stage2": "node scripts/verify-stage2.mjs",
    "verify:stage3": "node scripts/verify-stage2.mjs",
    "verify:stage4": "node scripts/verify-stage4.mjs",
    "verify:stage5": "node scripts/verify-stage5.mjs",
    "verify:stage6": "node scripts/verify-stage6.mjs",
    "verify:stage7": "node scripts/verify-stage7.mjs",
    "verify:stage8": "node scripts/verify-stage8.mjs",
    "capture:stage2": "node scripts/capture-stage2.mjs",
    "capture:stage3": "node scripts/capture-stage3.mjs"
  },
  "keywords": [],
  "author": {
    "name": "Jinyan Shao",
    "email": "jinyanshao@proton.me"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.11.0",
    "@milkdown/crepe": "^7.21.3",
    "electron-squirrel-startup": "^1.0.1",
    "lucide": "^1.28.0",
    "write-file-atomic": "^8.0.0",
    "yaml": "^2.9.0"
  }
}
